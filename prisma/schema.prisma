// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  username        String
  displayUsername String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  role            String    @default("usuario")
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Trilha de auditoria de ações administrativas (LGPD: dados de RH exigem rastreabilidade de acesso/alteração).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// Empresa cliente (o ERP é multi-empresa — código "005" etc. no cabeçalho dos relatórios).
model Empresa {
  id        String   @id @default(cuid())
  codigo    String
  nome      String
  // Nome curto pra exibir em gráficos e resumos (ex.: "Pantanal" em vez do nome completo/razão
  // social). Sugerido automaticamente na importação (primeira palavra do nome), editável.
  abbr      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Valor unitário da cesta básica; usado para converter em crédito de VR quando o colaborador
  // opta por "receber a cesta no VR" em vez da cesta física.
  valorCestaBasica Decimal?

  funcionarios         Funcionario[]
  terceiros            Terceiro[]
  importacoes          Importacao[]
  apuracoes            Apuracao[]
  bancoHorasImportacoes BancoHorasImportacao[]

  @@unique([codigo])
  @@map("empresa")
}

// Cargo = "Função" do relatório de salários. Compartilhado entre empresas (mesma ideia do ERP:
// "MOTORISTA" é um cargo só, não um por empresa — o salário de fato vive em Funcionario).
model Cargo {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Elegibilidade padrão do cargo; Funcionario pode sobrescrever individualmente.
  recebeCestaBasica  Boolean @default(true)
  recebeValeRefeicao Boolean @default(true)

  // Sincronizados manualmente via botão na tela de cargos (relatório "Relação Funcionários" do
  // ERP); nunca sobrescritos automaticamente — divergência do arquivo só é reportada.
  departamento String?
  setor        String?

  funcionarios Funcionario[]

  @@unique([nome])
  @@map("cargo")
}

model Funcionario {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  matricula    String
  nome         String
  dataAdmissao DateTime
  cargoId      String
  cargo        Cargo    @relation(fields: [cargoId], references: [id])
  salario      Decimal

  // "ativo" | "afastado" | "desligado"
  status           String    @default("ativo")
  dataAfastamento  DateTime?
  dataDesligamento DateTime?
  // Data do último retorno de afastamento — mantida mesmo depois do status voltar pra "ativo",
  // pra apuração de benefícios ainda conseguir proporcionalizar o mês em que ele voltou (dias
  // antes do retorno não contam como trabalhados). Só é relevante enquanto cai dentro do mês da
  // competência sendo apurada; competências seguintes ignoram esse campo.
  dataRetorno      DateTime?

  // null = usa o padrão do cargo; true/false = sobrescreve para este funcionário.
  recebeCestaBasica  Boolean?
  recebeValeRefeicao Boolean?
  // null = calculado como percentual do salário; valor definido aqui força um total diferente.
  valorValeRefeicao  Decimal?

  // Relatório 2 (afastamentos): motivo do afastamento, ex. "Licença sem Remuneração" — usado
  // na regra de perda de cesta básica quando não completa 28 dias trabalhados no mês.
  motivoAfastamento String?
  // Opção manual: para cálculo do VR, soma 40% ao salário base antes de aplicar o percentual
  // (colaboradores com gratificação).
  temGratificacao   Boolean @default(false)
  // Opção do colaborador: converter o valor da cesta básica em crédito no VR em vez de receber a cesta física.
  recebeCestaComoVR Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faltas Falta[]

  bancoHorasSaldoInicial BancoHorasSaldoInicial?
  bancoHorasApuracoes    BancoHorasApuracao[]
  bancoHorasLotes        BancoHorasLoteCredito[]

  @@unique([empresaId, matricula])
  @@index([cargoId])
  @@map("funcionario")
}

// Relatório 3 (faltas): uma linha por data de falta, não um contador do mês — a data exata é
// necessária pra apurar qualquer competência retroativa e, futuramente, o período aquisitivo de
// férias (12 meses corridos desde a admissão, não o mês corrente).
model Falta {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  data          DateTime
  createdAt     DateTime    @default(now())

  @@unique([funcionarioId, data])
  @@index([funcionarioId])
  @@map("falta")
}

// Cadastro de terceiros (não vêm da folha do ERP): opção de lançar manualmente e manter
// recebendo benefício, fora da régua de elegibilidade por cargo/salário dos funcionários.
model Terceiro {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  documento String?
  ativo     Boolean @default(true)

  recebeCestaBasica  Boolean  @default(true)
  recebeValeRefeicao Boolean  @default(false)
  valorValeRefeicao  Decimal?
  recebeCestaComoVR  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("terceiro")
}

// Apuração mensal de benefícios (cesta básica + VR) por empresa/competência. Persistida (em vez
// de recalculada em tempo real) para permitir reabrir o relatório de um mês fechado mesmo depois
// que a folha seguinte sobrescrever salário/faltas/afastamento dos cadastros de origem.
model Apuracao {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  competencia String
  geradoPorId String
  createdAt   DateTime @default(now())

  itens ApuracaoItem[]

  @@unique([empresaId, competencia])
  @@index([empresaId])
  @@map("apuracao")
}

model ApuracaoItem {
  id         String   @id @default(cuid())
  apuracaoId String
  apuracao   Apuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)

  // "funcionario" | "terceiro" — dados abaixo são um snapshot no momento do cálculo, para o
  // relatório continuar íntegro mesmo se o cadastro de origem mudar ou for removido depois.
  tipo         String
  matricula    String?
  nome         String
  cargo        String?
  salario      Decimal?
  dataAdmissao DateTime?

  elegivelCestaBasica  Boolean
  motivoPerdaCesta     String?
  recebeCestaComoVR    Boolean  @default(false)
  valorCestaConvertida Decimal?

  elegivelVR    Boolean
  motivoPerdaVR String?
  baseCalculoVR Decimal?
  valorVR       Decimal

  createdAt DateTime @default(now())

  @@index([apuracaoId])
  @@map("apuracao_item")
}

// Log de cada importação de arquivo (rastreabilidade + auditoria dos dados de RH). Também é a
// fonte da checklist "o que já foi importado nesta competência" — um arquivo que cobre várias
// empresas de uma vez (ex.: situação/vale-refeição) gera uma linha por empresa afetada.
model Importacao {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  // "folha_salarios" | "situacao_vale_refeicao" | "faltas" | "afastamentos"
  tipo           String   @default("folha_salarios")
  importadoPorId String
  nomeArquivo    String
  competencia    String
  criados        Int
  atualizados    Int
  naoEncontrados String?
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@index([empresaId, tipo, competencia])
  @@map("importacao")
}

// Saldo de abertura do Banco de Horas por funcionário, marco zero = dezembro/2025.
// Hardcoded manualmente (seed), serve de ponto de partida do motor de cálculo em jan/2026.
model BancoHorasSaldoInicial {
  id            String      @id @default(cuid())
  funcionarioId String      @unique
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  competencia   String      // sempre "12/2025"
  saldoDecimal  Decimal     // pode ser negativo, em horas decimais (não HH:MM)
  createdAt     DateTime    @default(now())

  @@map("banco_horas_saldo_inicial")
}

// Um registro por funcionário/competência processada — resultado do motor de cálculo.
// Substituído (não versionado) quando a competência é reimportada, conforme regra (e) do plano.
model BancoHorasApuracao {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  competencia   String      // "MM/AAAA"

  creditoBruto   Decimal   // vindo do TXT, em horas decimais
  debitoBruto    Decimal   // vindo do TXT, em horas decimais
  creditoLiquido Decimal   // 50% do bruto, arredondado pra cima ao minuto — o que entra no banco
  pagoNoMes      Decimal   // 50% do bruto (regra a) + expirações de lotes antigos (regra d)
  saldoPositivo  Decimal   // soma dos lotes de crédito ainda não vencidos/consumidos, ao fechar
  saldoNegativo  Decimal   // sempre <= 0; valor agregado, sem FIFO
  saldoFinal     Decimal   // saldoPositivo + saldoNegativo — o que aparece no resumo do mês

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funcionarioId, competencia])
  @@index([funcionarioId])
  @@map("banco_horas_apuracao")
}

// Lotes de crédito individuais (FIFO), para rastrear consumo e vencimento (regra d).
// Um lote nasce na competência de origem e vence no fechamento da competência seguinte.
// O saldo de abertura (dez/2025) também entra como um lote, com origem "12/2025".
model BancoHorasLoteCredito {
  id                String      @id @default(cuid())
  funcionarioId     String
  funcionario       Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  competenciaOrigem String      // "MM/AAAA" — mês em que o crédito foi gerado (ou "12/2025" pro saldo inicial)
  valorOriginal     Decimal
  valorConsumido    Decimal     @default(0)
  // "aberto" | "consumido" | "expirado_pago"
  status            String      @default("aberto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funcionarioId, status])
  @@map("banco_horas_lote_credito")
}

// Log de importação do extrato de banco de horas, mesmo padrão de `Importacao` — mas tipado à
// parte porque o extrato não tem empresaId no cabeçalho de cada bloco (casa só por matrícula).
model BancoHorasImportacao {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  importadoPorId String
  nomeArquivo    String
  periodoInicio  String   // "MM/AAAA"
  periodoFim     String   // "MM/AAAA"
  criados        Int
  atualizados    Int
  naoEncontrados String?
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@map("banco_horas_importacao")
}
