// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  username        String
  displayUsername String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  role            String    @default("usuario")
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Trilha de auditoria de ações administrativas (LGPD: dados de RH exigem rastreabilidade de acesso/alteração).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// Empresa cliente (o ERP é multi-empresa — código "005" etc. no cabeçalho dos relatórios).
model Empresa {
  id        String   @id @default(cuid())
  codigo    String
  nome      String
  // Nome curto pra exibir em gráficos e resumos (ex.: "Pantanal" em vez do nome completo/razão
  // social). Sugerido automaticamente na importação (primeira palavra do nome), editável.
  abbr      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Valor unitário da cesta básica; usado para converter em crédito de VR quando o colaborador
  // opta por "receber a cesta no VR" em vez da cesta física.
  valorCestaBasica Decimal?

  funcionarios         Funcionario[]
  terceiros            Terceiro[]
  importacoes          Importacao[]
  apuracoes            Apuracao[]
  bancoHorasImportacoes BancoHorasImportacao[]
  indicadoresMensais   IndicadorMensal[]
  rateiosTotais        RateioTotalCampo[]

  @@unique([codigo])
  @@map("empresa")
}

// Cargo = "Função" do relatório de salários. Compartilhado entre empresas (mesma ideia do ERP:
// "MOTORISTA" é um cargo só, não um por empresa — o salário de fato vive em Funcionario).
model Cargo {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Elegibilidade padrão do cargo; Funcionario pode sobrescrever individualmente.
  recebeCestaBasica  Boolean @default(true)
  recebeValeRefeicao Boolean @default(true)

  // Sincronizados manualmente via botão na tela de cargos (relatório "Relação Funcionários" do
  // ERP); nunca sobrescritos automaticamente — divergência do arquivo só é reportada.
  departamento String?
  setor        String?

  funcionarios Funcionario[]

  @@unique([nome])
  @@map("cargo")
}

model Funcionario {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  matricula    String
  nome         String
  // Nome completo vindo do import de situação/VR — separado de `nome` pra não afetar telas
  // que já usam `nome` (Banco de Horas, Cesta Básica etc.). Usado futuramente pra exportação
  // de arquivo pro banco.
  nomeCompleto String?
  cpf          String?
  telefone     String?
  dataAdmissao DateTime
  cargoId      String
  cargo        Cargo    @relation(fields: [cargoId], references: [id])
  salario      Decimal

  // "ativo" | "afastado" | "desligado"
  status           String    @default("ativo")
  dataAfastamento  DateTime?
  dataDesligamento DateTime?
  // Data do último retorno de afastamento — mantida mesmo depois do status voltar pra "ativo",
  // pra apuração de benefícios ainda conseguir proporcionalizar o mês em que ele voltou (dias
  // antes do retorno não contam como trabalhados). Só é relevante enquanto cai dentro do mês da
  // competência sendo apurada; competências seguintes ignoram esse campo.
  dataRetorno      DateTime?

  // null = usa o padrão do cargo; true/false = sobrescreve para este funcionário.
  recebeCestaBasica  Boolean?
  recebeValeRefeicao Boolean?
  // null = calculado como percentual do salário; valor definido aqui força um total diferente.
  valorValeRefeicao  Decimal?

  // Relatório 2 (afastamentos): motivo do afastamento, ex. "Licença sem Remuneração" — usado
  // na regra de perda de cesta básica quando não completa 28 dias trabalhados no mês.
  motivoAfastamento String?
  // Opção manual: para cálculo do VR, soma 40% ao salário base antes de aplicar o percentual
  // (colaboradores com gratificação).
  temGratificacao   Boolean @default(false)
  // Opção do colaborador: converter o valor da cesta básica em crédito no VR em vez de receber a cesta física.
  recebeCestaComoVR Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faltas Falta[]
  cats   Cat[]

  bancoHorasSaldoInicial BancoHorasSaldoInicial?
  bancoHorasApuracoes    BancoHorasApuracao[]
  bancoHorasLotes        BancoHorasLoteCredito[]

  feriasPeriodos Ferias[]

  @@unique([empresaId, matricula])
  @@index([cargoId])
  @@map("funcionario")
}

// Relatório 3 (faltas): uma linha por data de falta, não um contador do mês — a data exata é
// necessária pra apurar qualquer competência retroativa e, futuramente, o período aquisitivo de
// férias (12 meses corridos desde a admissão, não o mês corrente).
model Falta {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  data          DateTime
  // Sigla da ocorrência vinda do relatório (ATM, FALTA, FALTJ, SUSP etc.). Só "FALTA" (falta sem
  // justificativa) entra na conta de elegibilidade de cesta básica/VA — as demais são
  // afastamentos amparados (atestado médico, óbito, suspensão, paternidade, casamento etc.) e
  // não descontam benefício.
  ocorrencia    String?
  createdAt     DateTime    @default(now())

  @@unique([funcionarioId, data])
  @@index([funcionarioId])
  @@map("falta")
}

// Relatório de CAT (Comunicado de Acidente de Trabalho): guardado cru por enquanto, sem indicador
// nenhum montado em cima ainda — só a base pra quando o dashboard de segurança do trabalho for
// desenhado. O relatório não traz código de empresa, só matrícula (mesmo casamento por matrícula
// usado em situação/afastamentos).
model Cat {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  dataAcidente  DateTime
  dataEmissao   DateTime
  houveAfastamento Boolean
  // Número do CAT quando o relatório traz (nem toda linha tem — fica null quando ainda não emitido).
  numeroCat        String?
  // Código do tipo de acidente (TIPOACIDCAT) tal como vem do relatório — 1, 2, 3... sem tabela de
  // depara nossa ainda.
  tipoAcidente     String
  descricaoAcidente String
  // "A" | "D" | "F" — situação do funcionário no momento da emissão, como veio no relatório
  // (pode não bater com o status atual do cadastro).
  situacaoFuncionario String
  codSetor            String
  descSetor           String
  createdAt           DateTime @default(now())

  @@unique([funcionarioId, dataAcidente])
  @@index([funcionarioId])
  @@map("cat")
}

// Snapshot mensal de indicadores de RH/folha por empresa+área, alimentado pelo PDF "Resumo
// Gerencial Analítico" do ERP (um snapshot é necessário porque o cadastro de Funcionario só
// reflete o estado atual — não dá pra reconstruir headcount de um mês passado a partir dele).
// Campos derivados (custo total do empregador, custo por funcionário, custo total de benefícios,
// % de encargos sobre a folha, taxa de rotatividade) são calculados na leitura, não guardados aqui.
model IndicadorMensal {
  id          String  @id @default(cuid())
  empresaId   String
  empresa     Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  competencia String // "mm/yyyy"
  // "MANUTENCAO" | "ADMINISTRACAO" | "OPERACAO" | "OPERACAO MOTORISTA" — mesmos valores de Cargo.setor
  setor       String

  ativos     Int
  admitidos  Int
  desligados Int
  afastados  Int
  // Sem código/linha própria no relatório — sempre lançado manualmente. Descontado de
  // ativos/admitidos/desligados só na hora de calcular turnover (aprendiz não entra nessa conta).
  aprendizesAtivos     Int @default(0)
  aprendizesAdmitidos  Int @default(0)
  aprendizesDesligados Int @default(0)

  folhaBruta     Decimal
  liquidoPagar   Decimal
  // Códigos 00003 + 00659 (hora extra 50%) somados — valor em R$ e a referência em horas.
  horaExtra      Decimal
  horaExtraHoras Decimal
  // Código 00227.
  comissao Decimal @default(0)
  // Não vem do PDF nenhum — sempre lançado manualmente (folha processada à parte).
  folhaSuplementar Decimal @default(0)
  // Dias de falta (quantidade, campo REFER do código 00508) e atestados (código
  // 00752), cada um com o valor em R$ descontado por causa deles.
  faltasDias      Decimal
  faltasValor     Decimal
  atestadosDias   Decimal
  atestadosValor  Decimal
  // INSS retido do funcionário (não o total patronal+retido) — "INSS Retido dos Funcionarios".
  inssRetido      Decimal
  fgts            Decimal
  // Encargos patronais extraídos do relatório: "INSS da Empresa" (parte patronal), "Acidente de
  // Trabalho" (RAT/SAT) e "Terceiros" (Sistema S, INCRA, salário educação etc.).
  inssPatronal      Decimal @default(0)
  acidenteTrabalho  Decimal @default(0)
  terceiros         Decimal @default(0)
  // Descontos por código: 00381 farmácia (nome do fornecedor varia por empresa — ex. "BIG
  // MASTER" — por isso extraído pelo código, não pelo rótulo), 00492 contribuição confederativa,
  // 00493 contribuição social (sindical).
  farmacia                  Decimal @default(0)
  contribuicaoConfederativa Decimal @default(0)
  contribuicaoSocial        Decimal @default(0)
  // O relatório desse mês traz o IRRF sobre férias (código 00481) já da competência corrente,
  // mas o IRRF normal (código 00453) sai defasado em 1 mês no sistema de origem — por isso os
  // dois ficam crus aqui, e o IRRF "do mês" exibido no dashboard é montado na leitura somando
  // irrfFerias da competência atual + irrfNormal da competência ANTERIOR (ver actions.ts).
  irrfFerias      Decimal
  irrfNormal      Decimal
  // Benefícios extraídos do PDF (códigos 00970, 00972, 00971) — o custo total de benefícios é
  // calculado na leitura somando esses 3 com os 3 abaixo, que não têm código no relatório e
  // ficam sempre editáveis.
  cestaBasica     Decimal @default(0)
  valeGas         Decimal @default(0)
  valeAlimentacao Decimal @default(0)
  cafeManha       Decimal @default(0)
  refeitorio      Decimal @default(0)
  proSaude        Decimal @default(0)

  // Nomes dos campos acima que vieram editados manualmente (o parser não achou no PDF, ou o
  // usuário corrigiu) — só pra sinalizar na tela, não afeta nenhum cálculo.
  camposManuais String?

  importadoPorId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, setor, competencia])
  @@index([empresaId, competencia])
  @@map("indicador_mensal")
}

// Valor total mensal de um benefício "sempre editável" (pró-saúde, folha suplementar, café da
// manhã, refeitório — ver RATEIO_CAMPOS em lib/indicadores.ts), lançado uma vez por empresa (não
// por área). O rateio por área é feito na leitura: ativos da área / total de ativos da empresa ×
// este valor (ver carregarIndicadores). Substitui o antigo lançamento manual por área desses
// campos em IndicadorMensal.
model RateioTotalCampo {
  id          String  @id @default(cuid())
  empresaId   String
  empresa     Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  competencia String // "mm/yyyy"
  // Nome do campo de IndicadorMensal que este total rateia (ex.: "proSaude", "folhaSuplementar").
  campo       String
  valor       Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, competencia, campo])
  @@map("rateio_total_campo")
}

// Cadastro de terceiros (não vêm da folha do ERP): opção de lançar manualmente e manter
// recebendo benefício, fora da régua de elegibilidade por cargo/salário dos funcionários.
model Terceiro {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  documento String?
  ativo     Boolean @default(true)

  recebeCestaBasica  Boolean  @default(true)
  recebeValeRefeicao Boolean  @default(false)
  valorValeRefeicao  Decimal?
  recebeCestaComoVR  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("terceiro")
}

// Apuração mensal de benefícios (cesta básica + VR) por empresa/competência. Persistida (em vez
// de recalculada em tempo real) para permitir reabrir o relatório de um mês fechado mesmo depois
// que a folha seguinte sobrescrever salário/faltas/afastamento dos cadastros de origem.
model Apuracao {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  competencia String
  geradoPorId String
  createdAt   DateTime @default(now())

  // Cesta básica e vale-alimentação fecham em datas diferentes, então cada um tem seu próprio
  // "processado em" — reprocessar um não mexe no horário do outro.
  geradoCestaEm DateTime?
  geradoVrEm    DateTime?

  itens ApuracaoItem[]

  @@unique([empresaId, competencia])
  @@index([empresaId])
  @@map("apuracao")
}

model ApuracaoItem {
  id         String   @id @default(cuid())
  apuracaoId String
  apuracao   Apuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)

  // "funcionario" | "terceiro" — dados abaixo são um snapshot no momento do cálculo, para o
  // relatório continuar íntegro mesmo se o cadastro de origem mudar ou for removido depois.
  tipo         String
  // Id de origem (Funcionario.id ou Terceiro.id) — usado só pra reconciliar a linha entre um
  // processamento de cesta básica e um de vale-alimentação (datas diferentes), sem depender de
  // matrícula (terceiro não tem). Null em snapshots antigos, gerados antes dessa separação.
  funcionarioId String?
  terceiroId    String?
  matricula     String?
  nome          String
  cargo         String?
  salario       Decimal?
  dataAdmissao  DateTime?

  elegivelCestaBasica  Boolean
  motivoPerdaCesta     String?
  recebeCestaComoVR    Boolean  @default(false)
  valorCestaConvertida Decimal?

  elegivelVR    Boolean
  motivoPerdaVR String?
  baseCalculoVR Decimal?
  valorVR       Decimal

  createdAt DateTime @default(now())

  @@unique([apuracaoId, funcionarioId])
  @@unique([apuracaoId, terceiroId])
  @@index([apuracaoId])
  @@map("apuracao_item")
}

// Log de cada importação de arquivo (rastreabilidade + auditoria dos dados de RH). Também é a
// fonte da checklist "o que já foi importado nesta competência" — um arquivo que cobre várias
// empresas de uma vez (ex.: situação/vale-refeição) gera uma linha por empresa afetada.
model Importacao {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  // "folha_salarios" | "situacao_vale_refeicao" | "faltas" | "afastamentos" | "ferias" | "cat"
  // | "indicadores_mensais"
  tipo           String   @default("folha_salarios")
  importadoPorId String
  nomeArquivo    String
  competencia    String
  criados        Int
  atualizados    Int
  naoEncontrados String?
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@index([empresaId, tipo, competencia])
  @@map("importacao")
}

// Saldo de abertura do Banco de Horas por funcionário, marco zero = dezembro/2025.
// Hardcoded manualmente (seed), serve de ponto de partida do motor de cálculo em jan/2026.
model BancoHorasSaldoInicial {
  id            String      @id @default(cuid())
  funcionarioId String      @unique
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  competencia   String      // sempre "12/2025"
  saldoDecimal  Decimal     // pode ser negativo, em horas decimais (não HH:MM)
  createdAt     DateTime    @default(now())

  @@map("banco_horas_saldo_inicial")
}

// Um registro por funcionário/competência processada — resultado do motor de cálculo.
// Substituído (não versionado) quando a competência é reimportada, conforme regra (e) do plano.
model BancoHorasApuracao {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  competencia   String      // "MM/AAAA"

  creditoBruto   Decimal   // vindo do TXT, em horas decimais
  debitoBruto    Decimal   // vindo do TXT, em horas decimais
  creditoLiquido Decimal   // 50% do bruto, arredondado pra cima ao minuto — o que entra no banco
  pagoNoMes      Decimal   // 50% do bruto (regra a) + expirações de lotes antigos (regra d)
  saldoPositivo  Decimal   // soma dos lotes de crédito ainda não vencidos/consumidos, ao fechar
  saldoNegativo  Decimal   // sempre <= 0; valor agregado, sem FIFO
  saldoFinal     Decimal   // saldoPositivo + saldoNegativo — o que aparece no resumo do mês

  // Funcionário afastado há mais de 30 dias nesta competência: saldoFinal = saldo da competência
  // anterior, intocado (nenhum crédito gerado, saldo anterior não pago) — ver
  // src/lib/banco-horas-afastamento.ts. Volta a processar normalmente quando ele retornar.
  congelado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funcionarioId, competencia])
  @@index([funcionarioId])
  @@map("banco_horas_apuracao")
}

// Lotes de crédito individuais (FIFO), para rastrear consumo e vencimento (regra d).
// Um lote nasce na competência de origem e vence no fechamento da competência seguinte.
// O saldo de abertura (dez/2025) também entra como um lote, com origem "12/2025".
model BancoHorasLoteCredito {
  id                String      @id @default(cuid())
  funcionarioId     String
  funcionario       Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  competenciaOrigem String      // "MM/AAAA" — mês em que o crédito foi gerado (ou "12/2025" pro saldo inicial)
  valorOriginal     Decimal
  valorConsumido    Decimal     @default(0)
  // "aberto" | "consumido" | "expirado_pago"
  status            String      @default("aberto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funcionarioId, status])
  @@map("banco_horas_lote_credito")
}

// Um registro por período aquisitivo de férias de cada funcionário, vindo do relatório
// "Programação de Férias" do ERP. Reimportar o mesmo período (mesmo funcionário + vencimento)
// atualiza os dados de origem (faltas, limite etc.) sem apagar a programação já feita manualmente
// (mês, quinzena, abono) — ver regra de merge em `ferias-actions.ts`.
model Ferias {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  periodoAquisitivoInicio DateTime // "Aquisição" no relatório
  periodoAquisitivoFim    DateTime // "Vencimento" — fecha o período aquisitivo
  dataLimite              DateTime // "Limite" — prazo legal (CLT) pra iniciar o gozo
  meses                   Int // meses restantes até o limite, no momento da importação (informativo)
  faltas                  Int      @default(0)
  // Dias de direito, calculado pela regra de faltas da CLT (0-5=30, 6-14=24, 15-23=18, 24-32=12,
  // +32=0) — não copiado direto do arquivo, recalculado no import pra sempre bater com a regra.
  diasDireito             Int

  // Programação (preenchida manualmente na tela, nunca vem do arquivo importado).
  mes       Int? // 1-12
  ano       Int?
  quinzena  Int? // 1 ou 2
  diasAbono Int     @default(0)
  // "inicio" | "final"
  abonoTipo String?

  // Calculados a partir de mes/ano/quinzena/abono ao salvar a programação.
  gozoInicio    DateTime?
  gozoFim       DateTime?
  dataPagamento DateTime?

  // "pendente" | "programado" | "concluido"
  status String @default("pendente")

  // Autorização manual pra esse período aparecer no Painel/Mural — algumas programações não devem
  // ser expostas publicamente (ex.: cargos de confiança, situação ainda não confirmada com o
  // colaborador). Default true: some do mural só quem for desmarcado explicitamente.
  exibirMural Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funcionarioId, periodoAquisitivoFim])
  @@index([funcionarioId])
  @@map("ferias")
}

// Datas reais de início/fim de cada quinzena (mês/ano/1ª ou 2ª), definidas manualmente pelo RH —
// não seguem necessariamente dia 1-15/16-fim do mês civil (ex.: fechamento de folha pode ir de
// 05/01 a 03/02). Usado como referência na tela de calendário e como origem do "Início do gozo" ao
// programar férias; sem registro aqui, cai no padrão dia 1/dia 16 do mês (ver `calcularDatas`).
model QuinzenaPeriodo {
  id         String   @id @default(cuid())
  ano        Int
  mes        Int // 1-12
  quinzena   Int // 1 ou 2
  dataInicio DateTime
  dataFim    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ano, mes, quinzena])
  @@map("quinzena_periodo")
}

// Log de importação do extrato de banco de horas, mesmo padrão de `Importacao` — mas tipado à
// parte porque o extrato não tem empresaId no cabeçalho de cada bloco (casa só por matrícula).
model BancoHorasImportacao {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  importadoPorId String
  nomeArquivo    String
  periodoInicio  String   // "MM/AAAA"
  periodoFim     String   // "MM/AAAA"
  criados        Int
  atualizados    Int
  naoEncontrados String?
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@map("banco_horas_importacao")
}
